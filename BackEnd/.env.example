# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.

PORT=3000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/jobapp?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# ── Email (password reset) ────────────────────────────────────────────────────
# Leave EMAIL_USER blank in development — the reset token will be logged to console instead.
# For Gmail: create an App Password at myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="JobSwipe <noreply@example.com>"

# Deep-link prefix the reset email points to (mobile: custom scheme, web: https://yoursite.com)
APP_RESET_URL=myapp://reset-password

# ── Cloud File Storage (S3 / Cloudflare R2) ───────────────────────────────────
# Leave S3_BUCKET blank in development — files will be saved to ./uploads/ on disk instead.
#
# AWS S3:  set S3_BUCKET, S3_REGION, S3_ACCESS_KEY, S3_SECRET_KEY. Leave S3_ENDPOINT blank.
# Cloudflare R2:  set all five, including S3_ENDPOINT (your R2 account endpoint URL).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
